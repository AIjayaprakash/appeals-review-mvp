DATABASE_URL=postgresql://appeals:appeals@localhost:5433/appeals
CHROMA_URL=http://localhost:8000

# Intake/Evaluation/Summarization Agents (app/core/nodes.py) -- without these, only
# the mocked unit tests run; the opt-in real-model tests (tests/test_nodes_*.py) are
# skipped.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_INTAKE_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EVALUATION_DEPLOYMENT=gpt-4o
AZURE_OPENAI_SUMMARIZATION_DEPLOYMENT=gpt-4o-mini

# OCR fallback for scanned/image PDFs (app/services/ocr_service.py) -- typed PDFs
# never need this; only set if test_data grows a scanned-document fixture.
AZURE_VISION_ENDPOINT=
AZURE_VISION_KEY=

# Populated in later phases
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
